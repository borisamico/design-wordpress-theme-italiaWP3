#: inc/accessibilita/pagina.php:82
#, php-format
msgid "on %d page examined"
msgid_plural "on %d pages examined"
msgstr[0] "su %d pagina esaminata"
msgstr[1] "su %d pagine esaminate"

#: inc/accessibilita/pagina.php:87
msgid "Warnings"
msgstr "Avvisi"

#: inc/accessibilita/pagina.php:89
